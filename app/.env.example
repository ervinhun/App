# Copy to .env and build with --dart-define-from-file=.env.

# Required: the Google OAuth "Web application" client id.
GOOGLE_SERVER_CLIENT_ID=

# Optional: the backend URL. Defaults to the API on this machine.
# API_BASE_URL=

# iOS only: the Google OAuth "iOS" client id.
GOOGLE_IOS_CLIENT_ID=

# Optional: FeatureHub Edge URL and a server-evaluated API key. Without them every flag is off.
FEATUREHUB_URL=
FEATUREHUB_API_KEY=
